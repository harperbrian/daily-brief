{
  // On-time trigger for the brief and alert workflows. See src/index.js.
  "name": "brief-trigger",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // No public URL: the Worker only runs from its own cron.
  "workers_dev": false,
  "preview_urls": false,
  // Minute 1 of every hour, UTC. The Worker converts to local time itself (see TZ in src/index.js).
  "triggers": { "crons": ["1 * * * *"] },
  "vars": {
    "GITHUB_OWNER": "your-github-username",
    "GITHUB_REPO": "your-daily-brief-repo",
    "GITHUB_REF": "main"
  },
  // GITHUB_TOKEN is a secret: `npx wrangler secret put GITHUB_TOKEN`.
  "observability": { "enabled": true }
}
